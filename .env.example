# ── Site ───────────────────────────────────────────────────────────────
# Used for SEO metadata and OG image URLs (src/config/site.ts).
NEXT_PUBLIC_SITE_URL=https://coffeefive.com

# ── Sanity (CMS) ───────────────────────────────────────────────────────
# From sanity.io/manage → your project → Project ID. See docs/SANITY.md.
# Public: these ship in the browser bundle, which is expected.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Pinned API date. Bump deliberately; never set this to "latest".
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only. Editor-role token used by the seed and CSV scripts.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
SANITY_API_WRITE_TOKEN=

# ── Shopify Storefront API (cart + checkout; not yet wired up) ──────────
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Revalidation secret (for Shopify webhooks → /api/revalidate)
REVALIDATION_SECRET=your-secret-here

# ── Email ──────────────────────────────────────────────────────────────
RESEND_API_KEY=
